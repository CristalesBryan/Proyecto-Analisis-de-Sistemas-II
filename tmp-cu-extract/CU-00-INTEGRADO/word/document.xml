<w:document xmlns:wpc="http://schemas.microsoft.com/office/word/2010/wordprocessingCanvas" xmlns:cx="http://schemas.microsoft.com/office/drawing/2014/chartex" xmlns:cx1="http://schemas.microsoft.com/office/drawing/2015/9/8/chartex" xmlns:cx2="http://schemas.microsoft.com/office/drawing/2015/10/21/chartex" xmlns:cx3="http://schemas.microsoft.com/office/drawing/2016/5/9/chartex" xmlns:cx4="http://schemas.microsoft.com/office/drawing/2016/5/10/chartex" xmlns:cx5="http://schemas.microsoft.com/office/drawing/2016/5/11/chartex" xmlns:cx6="http://schemas.microsoft.com/office/drawing/2016/5/12/chartex" xmlns:cx7="http://schemas.microsoft.com/office/drawing/2016/5/13/chartex" xmlns:cx8="http://schemas.microsoft.com/office/drawing/2016/5/14/chartex" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:aink="http://schemas.microsoft.com/office/drawing/2016/ink" xmlns:am3d="http://schemas.microsoft.com/office/drawing/2017/model3d" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:oel="http://schemas.microsoft.com/office/2019/extlst" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:m="http://schemas.openxmlformats.org/officeDocument/2006/math" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:wp14="http://schemas.microsoft.com/office/word/2010/wordprocessingDrawing" xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing" xmlns:w10="urn:schemas-microsoft-com:office:word" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml" xmlns:w15="http://schemas.microsoft.com/office/word/2012/wordml" xmlns:w16cex="http://schemas.microsoft.com/office/word/2018/wordml/cex" xmlns:w16cid="http://schemas.microsoft.com/office/word/2016/wordml/cid" xmlns:w16="http://schemas.microsoft.com/office/word/2018/wordml" xmlns:w16du="http://schemas.microsoft.com/office/word/2023/wordml/word16du" xmlns:w16sdtdh="http://schemas.microsoft.com/office/word/2020/wordml/sdtdatahash" xmlns:w16sdtfl="http://schemas.microsoft.com/office/word/2024/wordml/sdtformatlock" xmlns:w16se="http://schemas.microsoft.com/office/word/2015/wordml/symex" xmlns:wpg="http://schemas.microsoft.com/office/word/2010/wordprocessingGroup" xmlns:wpi="http://schemas.microsoft.com/office/word/2010/wordprocessingInk" xmlns:wne="http://schemas.microsoft.com/office/word/2006/wordml" xmlns:wps="http://schemas.microsoft.com/office/word/2010/wordprocessingShape" mc:Ignorable="w14 w15 w16se w16cid w16 w16cex w16sdtdh w16sdtfl w16du wp14"><w:body><w:p><w:r><w:rPr><w:b/><w:sz w:val="28"/></w:rPr><w:t>Caso de Uso</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/><w:sz w:val="28"/></w:rPr><w:t>Sistema de Quejas, Reclamos, Denuncias y Sugerencias (QRDS)</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/><w:sz w:val="32"/></w:rPr><w:t>Portal Público e Inicio de Sesión</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/><w:sz w:val="24"/></w:rPr><w:t>Versión 1.0</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>Elaborado por :______________</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>Fecha Elaboración 16/08/2026</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/><w:sz w:val="22"/></w:rPr><w:t>Historial Revisiones</w:t></w:r></w:p><w:tbl><w:tblPr><w:tblStyle w:val="Tablaconcuadrcula"/><w:tblW w:type="auto" w:w="0"/><w:tblLook w:firstColumn="1" w:firstRow="1" w:lastColumn="0" w:lastRow="0" w:noHBand="0" w:noVBand="1" w:val="04A0"/></w:tblPr><w:tblGrid><w:gridCol w:w="2126"/><w:gridCol w:w="2126"/><w:gridCol w:w="2126"/><w:gridCol w:w="2126"/></w:tblGrid><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2126"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>Nombre</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2126"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>Fecha</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2126"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>Descripción del Cambio</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2126"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>Versión</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2126"/></w:tcPr><w:p><w:r><w:t>Bryan Cristales</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2126"/></w:tcPr><w:p><w:r><w:t>15/07/2026</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2126"/></w:tcPr><w:p><w:r><w:t>Definición Inicial</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2126"/></w:tcPr><w:p><w:r><w:t>1.0</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2126"/></w:tcPr><w:p><w:r><w:t>Revisión</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2126"/></w:tcPr><w:p><w:r><w:t>16/08/2026</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2126"/></w:tcPr><w:p><w:r><w:t>Integración de Portal Público e Inicio de Sesión en un único CU-00</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2126"/></w:tcPr><w:p><w:r><w:t>1.0</w:t></w:r></w:p></w:tc></w:tr></w:tbl><w:p><w:r><w:br w:type="page"/></w:r></w:p><w:p><w:r><w:rPr><w:b/><w:sz w:val="28"/></w:rPr><w:t>1. Introducción.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/><w:sz w:val="22"/></w:rPr><w:t>1.1. Objetivo.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>El presente CU tiene como objetivo describir la interacción del ciudadano y del usuario municipal con el Portal Público del Sistema QRDS. El portal permite acceder sin autenticación al registro de quejas, reclamos, denuncias y sugerencias y a la consulta de seguimiento; además, integra el proceso de inicio de sesión para los usuarios internos autorizados.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/><w:sz w:val="28"/></w:rPr><w:t>2. Definición Caso de Uso</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/><w:sz w:val="22"/></w:rPr><w:t>2.1 Actores.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>2.1.1. Ciudadano / Usuario Público.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>2.1.2. Usuario Municipal.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>2.1.3. Sistema QRDS.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>2.1.4. Servidor Web.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/><w:sz w:val="22"/></w:rPr><w:t>2.2 Precondiciones.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>2.2.1. Que el servidor web y los servicios requeridos por el Sistema QRDS se encuentren activos.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>2.2.2. Que la base de datos se encuentre operativa.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>2.2.3. Que el Portal Público se encuentre disponible mediante HTTPS.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>2.2.4. Para iniciar sesión, el usuario municipal debe contar con un usuario activo dentro de la aplicación. RN01.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/><w:sz w:val="22"/></w:rPr><w:t>2.3 Flujo Normal Básico</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>1. El usuario ingresa a la URL del Portal Público del Sistema QRDS.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>2. El sistema carga la página principal sin requerir autenticación.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>3. El sistema muestra las opciones principales:</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t xml:space="preserve">   a. Registrar Queja, Reclamo, Denuncia o Sugerencia.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t xml:space="preserve">   b. Consultar Seguimiento de Caso.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t xml:space="preserve">   c. Iniciar Sesión.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>4. El usuario selecciona una de las opciones disponibles.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>5. Si selecciona “Registrar Queja, Reclamo, Denuncia o Sugerencia”, el sistema continúa en FA01.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>6. Si selecciona “Consultar Seguimiento de Caso”, el sistema continúa en FA02.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>7. Si selecciona “Iniciar Sesión”, el sistema continúa en FA03.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>8. Fin del caso de uso.</w:t></w:r></w:p><w:p><w:r><w:br w:type="page"/></w:r></w:p><w:p><w:r><w:rPr><w:b/><w:sz w:val="22"/></w:rPr><w:t>2.4 Flujos Alternos.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>FA01: Registrar Queja, Reclamo, Denuncia o Sugerencia</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>1. El ciudadano selecciona la opción “Registrar Queja, Reclamo, Denuncia o Sugerencia”.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>2. El sistema redirige al formulario público correspondiente al CU-03 sin requerir autenticación.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>3. El registro deberá cumplir las reglas aplicables al registro de casos y a la generación del identificador de seguimiento. RN03 RN04.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>4. Fin del flujo alterno.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>FA02: Consultar Seguimiento de Caso</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>1. El ciudadano selecciona la opción “Consultar Seguimiento de Caso”.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>2. El sistema redirige al CU-05.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>3. El ciudadano ingresa el identificador o mecanismo de consulta autorizado.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>4. El sistema valida que el caso exista y muestra únicamente la información permitida para una consulta pública. RN09.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>5. Si el caso no existe o la consulta no es válida, el sistema informa la situación sin exponer información restringida.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>6. Fin del flujo alterno.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>FA03: Iniciar Sesión</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>1. El usuario municipal selecciona la opción “Iniciar Sesión”.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>2. El sistema despliega los siguientes campos:</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t xml:space="preserve">   a. Usuario.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t xml:space="preserve">   b. Contraseña.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>3. El usuario ingresa los datos correspondientes.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>4. El sistema habilita el botón “Acceder”.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>5. El usuario selecciona el botón “Acceder”.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>6. El sistema valida que el usuario se encuentre activo, que las credenciales sean correctas y que posea un rol y permisos válidos. RN01 RN02.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>7. Si las credenciales son válidas, el sistema registra el inicio de sesión en la bitácora de auditoría. RN14 RN15 RN16.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>8. El sistema permite el ingreso a la bandeja principal de acuerdo con el rol y permisos asignados.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>9. Fin del flujo alterno.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>FA04: Credenciales inválidas o usuario inactivo</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>1. El sistema rechaza el acceso.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>2. El sistema muestra un mensaje indicando que las credenciales no son válidas o que el usuario no se encuentra habilitado, sin revelar información sensible.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>3. El sistema regresa al paso 2 de FA03.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>4. Fin del flujo alterno.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>FA05: Cerrar Sesión</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>1. El usuario autenticado selecciona la opción “Cerrar Sesión”.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>2. El sistema invalida la sesión activa.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>3. El sistema registra el cierre de sesión en la bitácora de auditoría. RN14 RN15 RN16.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>4. El sistema redirige al Portal Público.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>5. Fin del flujo alterno.</w:t></w:r></w:p><w:p><w:r><w:br w:type="page"/></w:r></w:p><w:p><w:r><w:rPr><w:b/><w:sz w:val="22"/></w:rPr><w:t>2.5 Postcondiciones.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>2.5.1. El ciudadano accedió al módulo público seleccionado o el usuario municipal inició sesión correctamente.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>2.5.2. Si se inició o cerró sesión, el evento quedó registrado en la bitácora de auditoría con los datos requeridos.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>2.5.3. La consulta pública no expone información restringida ni modifica el caso.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>2.5.4. Si la autenticación falló, no se creó una sesión válida ni se concedió acceso a funciones internas.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/><w:sz w:val="28"/></w:rPr><w:t>3. Requerimientos Suplementarios o no Funcionales</w:t></w:r></w:p><w:tbl><w:tblPr><w:tblStyle w:val="Tablaconcuadrcula"/><w:tblW w:type="auto" w:w="0"/><w:tblLook w:firstColumn="1" w:firstRow="1" w:lastColumn="0" w:lastRow="0" w:noHBand="0" w:noVBand="1" w:val="04A0"/></w:tblPr><w:tblGrid><w:gridCol w:w="4252"/><w:gridCol w:w="4252"/></w:tblGrid><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4252"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>ID</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4252"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>Descripción</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4252"/></w:tcPr><w:p><w:r><w:t>RNF-01</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4252"/></w:tcPr><w:p><w:r><w:t>El Portal Público debe operar mediante HTTPS.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4252"/></w:tcPr><w:p><w:r><w:t>RNF-02</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4252"/></w:tcPr><w:p><w:r><w:t>Las credenciales no deben exponerse en URL, mensajes de error ni registros visibles al usuario.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4252"/></w:tcPr><w:p><w:r><w:t>RNF-03</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4252"/></w:tcPr><w:p><w:r><w:t>La interfaz debe ser responsive y permitir el acceso a las funciones públicas y de autenticación de forma clara.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4252"/></w:tcPr><w:p><w:r><w:t>RNF-04</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4252"/></w:tcPr><w:p><w:r><w:t>Las validaciones de autenticación y permisos deben ejecutarse en el sistema, no únicamente en la interfaz.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4252"/></w:tcPr><w:p><w:r><w:t>RNF-05</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4252"/></w:tcPr><w:p><w:r><w:t>Las bitácoras generadas por inicio y cierre de sesión deben ser inmutables desde las funciones normales de la aplicación.</w:t></w:r></w:p></w:tc></w:tr></w:tbl><w:p><w:r><w:rPr><w:b/><w:sz w:val="28"/></w:rPr><w:t>4. Anexos</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/><w:sz w:val="22"/></w:rPr><w:t>4.1. Reglas de Negocio:</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>4.1.1. Ver Documento: Reglas de Negocio y Reglas de Negocio de Casos de Uso (última versión formalizada).</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>Reglas principales aplicables: RN01 Acceso y autenticación; RN02 Control de permisos; RN03 Registro de casos; RN04 Identificador de seguimiento; RN09 Seguimiento; RN14 Bitácora de auditoría; RN15 Datos mínimos de bitácora; RN16 Inmutabilidad de bitácoras.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>Casos de uso relacionados: CU-03 Registrar Queja, Reclamo, Denuncia o Sugerencia y CU-05 Consultar Seguimiento de Caso.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b w:val="0"/></w:rPr><w:t>El inicio y cierre de sesión quedan integrados dentro del presente CU-00; por lo tanto, CU-01 deja de utilizarse como caso de uso independiente.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/><w:sz w:val="28"/></w:rPr><w:t>5. Firmas Necesarias</w:t></w:r></w:p><w:tbl><w:tblPr><w:tblStyle w:val="Tablaconcuadrcula"/><w:tblW w:type="auto" w:w="0"/><w:tblLook w:firstColumn="1" w:firstRow="1" w:lastColumn="0" w:lastRow="0" w:noHBand="0" w:noVBand="1" w:val="04A0"/></w:tblPr><w:tblGrid><w:gridCol w:w="2835"/><w:gridCol w:w="2835"/><w:gridCol w:w="2835"/></w:tblGrid><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2835"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>Persona</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2835"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>Sector</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2835"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>Firma</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2835"/></w:tcPr><w:p><w:r><w:t>Bryan Cristales</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2835"/></w:tcPr><w:p><w:r><w:t>Desarrollador</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2835"/></w:tcPr><w:p><w:r/></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2835"/></w:tcPr><w:p><w:r><w:t>Edy Ramirez</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2835"/></w:tcPr><w:p><w:r><w:t>Responsable Institucional</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2835"/></w:tcPr><w:p><w:r/></w:p></w:tc></w:tr></w:tbl><w:sectPr w:rsidR="00181B7B" w:rsidSect="00557FB4"><w:headerReference w:type="default" r:id="rId8"/><w:headerReference w:type="first" r:id="rId9"/><w:pgSz w:w="11906" w:h="16838"/><w:pgMar w:top="1417" w:right="1701" w:bottom="1417" w:left="1701" w:header="283" w:footer="283" w:gutter="0"/><w:pgBorders w:offsetFrom="page"><w:bottom w:val="single" w:sz="6" w:space="24" w:color="auto"/></w:pgBorders><w:cols w:space="708"/><w:titlePg/><w:docGrid w:linePitch="360"/></w:sectPr></w:body></w:document>